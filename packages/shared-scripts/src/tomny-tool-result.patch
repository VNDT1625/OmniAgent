+
+#[test]
+fn deserializes_tool_result_with_optional_translated_name() {
+    let json = r#"{"type":"tool_result","call_id":"c1","content":"ok","tool_name":"tomny_read"}"#;
+    let cmd: ProtocolCommand = serde_json::from_str(json).expect("tool result should deserialize");
+
+    assert_eq!(
+        cmd,
+        ProtocolCommand::ToolResult {
+            call_id: "c1".to_string(),
+            content: "ok".to_string(),
+            tool_name: Some("tomny_read".to_string()),
+            is_error: false,
+        }
+    );
+}
